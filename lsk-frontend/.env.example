# ==============================================================================
# [인천하이병원] 카페24 MySQL 데이터베이스 환경 변수 설정 템플릿
# 파일명: .env.local (이 파일을 복사하여 .env.local 로 저장 후 실제 접속 정보를 입력하세요)
# ==============================================================================

# 1. 카페24 DB 호스트 주소 (예: localhost 또는 카페24에서 부여한 DB 호스트명/IP)
CAFE24_DB_HOST=your_cafe24_db_host

# 2. MySQL 포트 번호 (기본값: 3306)
CAFE24_DB_PORT=3306

# 3. 카페24 DB 사용자 계정 (일반적으로 호스팅 계정 ID)
CAFE24_DB_USER=your_db_user

# 4. 카페24 DB 비밀번호
CAFE24_DB_PASSWORD=your_db_password

# 5. 카페24 데이터베이스명 (일반적으로 호스팅 계정 ID와 동일)
CAFE24_DB_NAME=your_db_name
